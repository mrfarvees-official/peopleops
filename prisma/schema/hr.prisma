// HR data. Every row belongs to a tenant (tenantId, plain column: tenants are never deleted).
// ownerUserId / managerUserId copy the employee's user and manager's user onto
// records that PBAC policies compare against (resource.ownerId, resource.managerId),
// so lists can be narrowed in SQL. The employee service keeps them in sync.

model OrgUnit {
  id        String    @id @default(uuid()) @db.VarChar(36)
  tenantId  String    @db.VarChar(36)
  code      String    @db.VarChar(32)
  name      String    @db.VarChar(128)
  parentId  String?   @db.VarChar(36)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)

  parent    OrgUnit?   @relation("OrgTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  OrgUnit[]  @relation("OrgTree")
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@map("hr_org_unit")
}

model Employee {
  id              String    @id @default(uuid()) @db.VarChar(36)
  tenantId        String    @db.VarChar(36)
  userId          String?   @unique @db.VarChar(36) // the login this employee uses, if any
  employeeNo      String    @db.VarChar(32)
  firstName       String    @db.VarChar(128)
  lastName        String    @db.VarChar(128)
  email           String    @db.VarChar(255)
  phone           String?   @db.VarChar(32)
  jobTitle        String?   @db.VarChar(128)
  orgUnitId       String?   @db.VarChar(36)
  managerId       String?   @db.VarChar(36)
  managerUserId   String?   @db.VarChar(36) // manager's login, copied for policy checks
  employmentType  String    @default("full_time") @db.VarChar(16)
  status          String    @default("active") @db.VarChar(16)
  hireDate        DateTime  @db.Date
  terminationDate DateTime? @db.Date
  monthlySalary   Decimal?  @db.Decimal(12, 2)
  nationalId      String?   @db.VarChar(32)
  address         String?   @db.VarChar(255)
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
  deletedAt       DateTime? @db.DateTime(3)

  orgUnit       OrgUnit?       @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  manager       Employee?      @relation("Reports", fields: [managerId], references: [id], onDelete: Restrict)
  reports       Employee[]     @relation("Reports")
  leaveRequests LeaveRequest[]
  attendance    Attendance[]
  payslips      Payslip[]

  @@unique([tenantId, employeeNo])
  @@index([tenantId, orgUnitId])
  @@index([tenantId, managerId])
  @@index([tenantId, status])
  @@map("hr_employee")
}

model LeaveType {
  id          String    @id @default(uuid()) @db.VarChar(36)
  tenantId    String    @db.VarChar(36)
  code        String    @db.VarChar(32)
  name        String    @db.VarChar(128)
  daysPerYear Decimal   @default(0) @db.Decimal(5, 1)
  isPaid      Boolean   @default(true)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  deletedAt   DateTime? @db.DateTime(3)

  requests LeaveRequest[]

  @@unique([tenantId, code])
  @@map("hr_leave_type")
}

model LeaveRequest {
  id            String    @id @default(uuid()) @db.VarChar(36)
  tenantId      String    @db.VarChar(36)
  employeeId    String    @db.VarChar(36)
  ownerUserId   String?   @db.VarChar(36)
  managerUserId String?   @db.VarChar(36)
  leaveTypeId   String    @db.VarChar(36)
  startDate     DateTime  @db.Date
  endDate       DateTime  @db.Date
  days          Decimal   @db.Decimal(4, 1)
  reason        String?   @db.VarChar(255)
  status        String    @default("draft") @db.VarChar(16) // draft | submitted | approved | rejected | cancelled
  decidedBy     String?   @db.VarChar(36)
  decidedAt     DateTime? @db.DateTime(3)
  decisionNote  String?   @db.VarChar(255)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)
  deletedAt     DateTime? @db.DateTime(3)

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([employeeId, startDate])
  @@index([managerUserId, status])
  @@map("hr_leave_request")
}

model Attendance {
  id            String    @id @default(uuid()) @db.VarChar(36)
  tenantId      String    @db.VarChar(36)
  employeeId    String    @db.VarChar(36)
  ownerUserId   String?   @db.VarChar(36)
  managerUserId String?   @db.VarChar(36)
  date          DateTime  @db.Date
  clockIn       DateTime? @db.DateTime(3)
  clockOut      DateTime? @db.DateTime(3)
  hours         Decimal?  @db.Decimal(4, 2)
  status        String    @default("present") @db.VarChar(16) // present | late | half_day | remote | absent
  note          String?   @db.VarChar(255)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)
  deletedAt     DateTime? @db.DateTime(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
  @@index([tenantId, date])
  @@index([managerUserId, date])
  @@map("hr_attendance")
}

model Candidate {
  id             String    @id @default(uuid()) @db.VarChar(36)
  tenantId       String    @db.VarChar(36)
  firstName      String    @db.VarChar(128)
  lastName       String    @db.VarChar(128)
  email          String    @db.VarChar(255)
  phone          String?   @db.VarChar(32)
  position       String    @db.VarChar(128)
  stage          String    @default("applied") @db.VarChar(16) // applied | screening | interview | offer | hired | rejected
  source         String?   @db.VarChar(64)
  expectedSalary Decimal?  @db.Decimal(12, 2)
  appliedAt      DateTime  @db.Date
  notes          String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @db.DateTime(3)
  deletedAt      DateTime? @db.DateTime(3)

  @@index([tenantId, stage])
  @@map("hr_candidate")
}

model PayrollRun {
  id              String    @id @default(uuid()) @db.VarChar(36)
  tenantId        String    @db.VarChar(36)
  period          String    @db.VarChar(7) // YYYY-MM
  status          String    @default("draft") @db.VarChar(16) // draft | generated | locked | published
  employeeCount   Int       @default(0)
  totalGross      Decimal   @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal   @default(0) @db.Decimal(14, 2)
  totalNet        Decimal   @default(0) @db.Decimal(14, 2)
  createdBy       String?   @db.VarChar(36)
  lockedAt        DateTime? @db.DateTime(3)
  publishedAt     DateTime? @db.DateTime(3)
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
  deletedAt       DateTime? @db.DateTime(3)

  payslips Payslip[]

  @@unique([tenantId, period])
  @@map("hr_payroll_run")
}

model Payslip {
  id            String   @id @default(uuid()) @db.VarChar(36)
  tenantId      String   @db.VarChar(36)
  runId         String   @db.VarChar(36)
  employeeId    String   @db.VarChar(36)
  ownerUserId   String?  @db.VarChar(36)
  managerUserId String?  @db.VarChar(36)
  status        String   @default("draft") @db.VarChar(16) // draft | published
  gross         Decimal  @db.Decimal(12, 2)
  deductions    Decimal  @db.Decimal(12, 2)
  net           Decimal  @db.Decimal(12, 2)
  details       Json
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([runId, employeeId])
  @@index([ownerUserId, status])
  @@map("hr_payslip")
}
